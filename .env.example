# Breakwater local environment template.
# Copy to .env for local overrides. Do not commit .env.

# --- Data-plane listeners (client traffic through Envoy) ---
ENVOY_HTTP_PORT=8080
# Milestone 4 will add HTTPS; plaintext HTTP is intentional for Milestone 3.
ENVOY_HTTPS_PORT=8443
# Control-plane Envoy admin (compose binds to 127.0.0.1 on the host)
ENVOY_ADMIN_PORT=9901

# Demonstration hosts (map in /etc/hosts or curl --resolve for local TLS)
API_HOST=api.breakwater.local
STATUS_HOST=status.breakwater.local

# Demo identity header for rate limiting (spoofable; not production auth)
CLIENT_ID_HEADER=x-client-id

# --- Upstreams ---
UPSTREAM_API_PORT=9001
UPSTREAM_STATUS_PORT=9002
# Development/test only. Set false for AWS validation so /__test__/* is absent.
ENABLE_TEST_CONTROLS=true
MAX_LATENCY_MS=30000
CORRELATION_HEADER=x-request-id

# --- Rate limit / Redis ---
REDIS_PORT=6379
RATE_LIMIT_GRPC_PORT=8081
# standard | used as documentation of default policy class
RATE_LIMIT_DEFAULT_FAILURE_POLICY=fail_open

# --- Control / observability (not client data-plane load) ---
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# --- Feature flags for later milestones ---
RATE_LIMIT_ENABLED=true
